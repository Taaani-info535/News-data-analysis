# Copy to .env for LOCAL runs only (never commit .env). In GitHub use Settings > Secrets and variables > Actions.
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
TELEGRAM_CHAT_ID=put-your-chat-id-here
# Optional (free key from fred.stlouisfed.org) - enables Treasury-yield context lines
FRED_API_KEY=
# Optional language-model polishing of report text (disabled unless llm.enabled: true in config)
LLM_API_KEY=
